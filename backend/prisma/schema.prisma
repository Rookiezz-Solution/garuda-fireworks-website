generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String?   @unique
  phone      String?   @unique
  password   String?
  role       String    @default("user")
  isActive   Boolean   @default(true)
  otp        String?
  otpExpiry  DateTime?
  createdOn  DateTime  @default(now())
  modifiedOn DateTime  @updatedAt
  createdBy  String?
  modifiedBy String?
  orders     Order[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  actualPrice Decimal
  offerPrice  Decimal?
  isCoupon    Boolean     @default(false)
  couponPrice Decimal?
  isFeatured  Boolean     @default(false)
  isAvailable Boolean     @default(true)
  createdOn   DateTime    @default(now())
  modifiedOn  DateTime    @updatedAt
  createdBy   String?
  modifiedBy  String?
  categoryId  Int?
  tags        String?
  isActive    Boolean     @default(true)
  images      Image[]
  orderItems  OrderItem[]
  category    Category?   @relation(fields: [categoryId], references: [id])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdOn   DateTime  @default(now())
  modifiedOn  DateTime  @updatedAt
  products    Product[]
}

model Image {
  id        Int     @id @default(autoincrement())
  productId Int
  imageUrl  String
  isActive  Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String   @unique
  email           String?
  deliveryAddress String?
  isActive        Boolean  @default(true)
  createdOn       DateTime @default(now())
  modifiedOn      DateTime @updatedAt
  orders          Order[]
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int
  userId     Int?
  status     String      @default("ordered")
  total      Decimal
  isActive   Boolean     @default(true)
  createdOn  DateTime    @default(now())
  modifiedOn DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  message   String
  eventDate DateTime?
  budget    String?
  status    String    @default("pending")
  createdOn DateTime  @default(now())
}

model OTPLog {
  id         Int      @id @default(autoincrement())
  identifier String
  otp        String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdOn  DateTime @default(now())
}

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  description   String?
  discountType  String    @default("percentage")
  discountValue Decimal
  minOrderValue Decimal?
  maxUses       Int?
  usedCount     Int       @default(0)
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdOn     DateTime  @default(now())
  modifiedOn    DateTime  @updatedAt
}
